# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Neo4j Desktop (default bolt port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Scraper settings
GITHUB_TOKEN=                  # Optional but raises rate limit from 60 to 5000 req/hr
GITHUB_REPO=apache/iceberg
GITHUB_MAX_ITEMS=200           # Number of PRs and issues to fetch each
